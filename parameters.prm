# Listing of Parameters
# ---------------------
subsection Restart
  set restart = false
end

subsection Finite element system
  # Displacement system polynomial order
  set Polynomial degree - displacement = 1

  # Gauss quadrature order
  set Quadrature order - displacement = 2

  # Concentration system polynomial order
  set Polynomial degree - concentration = 1

  # Concentration quadrature order
  set Quadrature order - concentration = 2
end


subsection Geometry
  # Global refinement level
  set Global refinement   = 4

  # Global grid scaling factor
  set Grid scale          = 1
end


subsection Material properties
  # elastic constants
  set C11 austenite = 146.7
  set C12 austenite = 068.5
  set C13 austenite = 071.0
  set C33 austenite = 163.3
  set C44 austenite = 026.0

  set C11 martensite = 161.7
  set C12 martensite = 072.6
  set C13 martensite = 053.5
  set C33 martensite = 195.6
  set C44 martensite = 033.7

  # kinetic coeff
  set kinetic coeff = 5e-4

  # interaction parameter
  set interaction parameter = 0.0286312

  # thermal jump
  set thermal jump = 0.0069978

  # limiting threshold
  set limiting threshold = 0.0069978

  # lattice geometry
  set a alpha = 3.2317
  set c alpha = 5.1450
  set a omega = 5.0320
  set c omega = 3.1289
end


subsection Time
  # End time
  set end time       = 1000

  # Time step size
  set time step = 100
end
